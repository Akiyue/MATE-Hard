# Python build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
_test*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local session / tool state
.claude/

# Training artefacts — large binaries / verbose logs (regenerated by scripts).
# We keep `results/` (eval CSVs underlying every table) and `tb/` (training-curve
# event files) in the repo so reviewers can verify numbers without retraining.
checkpoints/
logs/
runs/

# Paper sources & drafts (kept private, regenerated locally).
# Exception: the scripts that regenerate the figures and the supplementary
# hyperparameter sweep log are released, because the manuscript cites them.
paper/*
!paper/supplementary/
!paper/make_figures.py
!paper/make_figures_sprint4.py
!paper/make_figure_mate_hard_illustration.py
!paper/make_figure_training_curves.py
PAPER*.md
PAPER*.pdf
build_pdf*.py

# Peer-review correspondence: the journal's decision letter states that the
# reviewer comments are confidential. These must never be published.
revisions.txt
RESPONSE_TO_REVIEWERS.*

# Internal reports & scratch notes
SPRINT_*.md
SPRINT_*.pdf
PHASE_*.md
HANDOFF.md
CLAUDE*.md
*_REPORT.md
*_ROADMAP.md

# Notebooks (optional — uncomment to exclude)
# *.ipynb
.ipynb_checkpoints/

# Misc
*.log
*.tmp
